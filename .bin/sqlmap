#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(dirname "$DIR")"
CACHE_DIR="$REPO/.cache/pytools"
if [ ! -f "$CACHE_DIR/.ready" ]; then
    mkdir -p "$CACHE_DIR"
    LOCK="$CACHE_DIR/.unpack.lock"
    if command -v flock >/dev/null 2>&1; then
        (
            flock -x 9
            if [ ! -f "$CACHE_DIR/.ready" ]; then
                python3 -m zipfile -e "$DIR/_pytools.zip" "$CACHE_DIR"
                touch "$CACHE_DIR/.ready"
            fi
        ) 9>"$LOCK"
    else
        while ! mkdir "$LOCK.d" 2>/dev/null; do sleep 0.1; done
        trap 'rmdir "$LOCK.d" 2>/dev/null || true' EXIT
        if [ ! -f "$CACHE_DIR/.ready" ]; then
            python3 -m zipfile -e "$DIR/_pytools.zip" "$CACHE_DIR"
            touch "$CACHE_DIR/.ready"
        fi
    fi
fi
PY="$REPO/.venv/bin/python"
[ ! -x "$PY" ] && PY="python3"
export PYTHONPATH="$CACHE_DIR:${PYTHONPATH:-}"
exec "$PY" -c "from sqlmap.sqlmap import main; main()" "$@"
